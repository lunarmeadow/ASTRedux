<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ASTRedux.App"
             xmlns:view="using:ASTRedux.View"
             xmlns:viewModel="using:ASTRedux.ViewModel"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.DataTemplates>
        <DataTemplate DataType="{x:Type viewModel:ASTViewModel}">
            <view:ASTView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModel:RSoundViewModel}">
            <view:RSoundView/>
        </DataTemplate>
    </Application.DataTemplates>
</Application>